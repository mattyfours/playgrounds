<playground-app class="block">
  <div class="p-8 flex flex-col gap-3">
    {% assign finshes_processed_list = '' | split: ',' | uniq | compact %}    
    {% for variant in variants %}
      {%- liquid
        assign other_finish_title = 'other'
        assign variant_finish_handle = variant.finish | default: other_finish_title | handleize | append: '|' | prepend: '|'
        assign variant_finish_title = variant.finish | default: other_finish_title | capitalize
        if finshes_processed_list contains variant_finish_handle
          continue
        endif
        assign finshes_processed_list = finshes_processed_list | append: variant_finish_handle
      -%}
        <h2 class="text-2xl font-bold">{{ variant_finish_title }}</h2>
        {% assign sub_vartiants = variants | slice: forloop.index0, variants.size %}
        <span class="text-xs text-gray-500 font-mono">Sub Variants: {{ sub_vartiants | size }}</span>
        
        <ul class="list-disc px-4 m-0 flex flex-col gap-1">
          {% for sub_variant in sub_vartiants %}
            {%- liquid
              assign sub_variant_finish_handle = sub_variant.finish | default: other_finish_title | handleize | append: '|' | prepend: '|'
              if sub_variant_finish_handle != variant_finish_handle
                continue
              endif
            -%}
            <li>{{ sub_variant.title }} - {{ sub_variant.finish }}</li>
          {% endfor %}
        </ul>
    {% endfor %}
  </div>
</playground-app>